# Site
NEXT_PUBLIC_SITE_URL=https://tappath.com

# Which LLM to prefer: openrouter | agentrouter | openai
# If unset, first available key wins (OpenRouter → AgentRouter → OpenAI)
COPILOT_PROVIDER=openrouter

# --- OpenRouter (https://openrouter.ai) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- AgentRouter (OpenAI-compatible gateway) ---
# Local aigw: http://localhost:1975/v1
# Or your hosted AgentRouter base
AGENTROUTER_API_KEY=
# AGENTIC_API_KEY=          # alias accepted
AGENTROUTER_BASE_URL=http://localhost:1975/v1
AGENTROUTER_MODEL=gpt-4o-mini
# AGENTROUTER_JSON_MODE=false   # set false if gateway rejects response_format

# --- OpenAI (direct) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
